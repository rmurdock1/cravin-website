# Local environment for `npm run dev` / `npm run build`.
# Copy to .env.local (git-ignored) and fill in the values. Never commit real keys.
#
# CAUTION: these point at the LIVE Supabase project. Anything you create locally
# (staff, postings, applications, uploads) is real production data.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xegvxlvjqoxcpgjtjlvu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security: Team Access invites, the audit log,
# careers applications and resume uploads.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Powers Scan ✨ document parsing on Staff profiles.
ANTHROPIC_API_KEY=

# Optional. Google Analytics 4 measurement ID. Leave empty locally so dev
# traffic stays out of GA.
NEXT_PUBLIC_GA_ID=
